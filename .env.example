# PHANTOM-ECHO REVEAL — Environment Variables Template
# Copy to .env and fill in your values before running cloud generation.
#
# REQUIRED for cloud VideoScene generation (Tier 1):
#   Sign up at https://runpod.io and deploy the VideoScene serverless endpoint
VIDEOSCENE_API_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/runsync
VIDEOSCENE_API_KEY=your_runpod_api_key_here

# OPTIONAL — controls simulation vs real cloud generation
# Set to "false" to enable live VideoScene API calls
PHANTOM_SIMULATE=true

# Output directory for PLY, mesh, costmap, and summary files
PHANTOM_OUTPUT=output

# Cloud server port (if running server.py separately)
PORT=8000

# Redis cache (for pre-baked VideoScene outputs)
# Defaults to localhost:6379 if not set
REDIS_URL=redis://localhost:6379/0

# GPU device for local Tier 2 generation (set to "cpu" if no GPU)
TORCH_DEVICE=cpu
