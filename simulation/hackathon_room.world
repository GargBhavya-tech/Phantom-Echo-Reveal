<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hackathon_room">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/phantom_echo</namespace></ros>
    </plugin>

    <light name="overhead_light" type="directional">
      <pose>2.5 2.0 2.4 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <pose>2.5 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5 0.02 4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5 0.02 4</size></box></geometry>
          <material><ambient>0.7 0.65 0.55 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Walls -->
    <model name="wall_front">
      <static>true</static>
      <pose>2.5 1.25 0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5 2.5 0.1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5 2.5 0.1</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_back">
      <static>true</static>
      <pose>2.5 1.25 4.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5 2.5 0.1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>5 2.5 0.1</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>0 1.25 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.5 4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 4</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>5.0 1.25 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.5 4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.5 4</size></box></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Table with occluded box (hero demo object) -->
    <model name="table">
      <static>true</static>
      <pose>2.5 0.375 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.2 0.75 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>1.2 0.75 0.6</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="cardboard_box">
      <static>true</static>
      <pose>2.5 0.825 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.35 0.3 0.35</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.35 0.3 0.35</size></box></geometry>
          <material><ambient>0.65 0.55 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Sofa occluding back wall -->
    <model name="sofa">
      <static>true</static>
      <pose>1.5 0.425 3.2 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.85 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.0 0.85 0.8</size></box></geometry>
          <material><ambient>0.3 0.25 0.4 1</ambient></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
