<?xml version="1.0" ?>
<!--
  PHANTOM-ECHO REVEAL — Gazebo Simulation World
  living_room_occluded.world

  5m x 4m x 2.5m indoor room with:
    - Visible front area (sofa + coffee table)
    - Occluded rear area (chair + desk behind divider wall)
    - Acoustic-reflective surfaces (all walls solid)

  For robot simulation: TurtleBot3 Waffle Pi
  Run: ros2 launch phantom_echo_reveal sim_bringup.launch.py
-->
<sdf version="1.8">
  <world name="living_room_occluded">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Lighting (single overhead + ambient) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <ambient>0.3 0.3 0.3 1</ambient>

    <!-- ── Room Structure ────────────────────────────────────────────── -->

    <!-- Floor -->
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.05 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.05 4.0</size></box></geometry>
          <material><ambient>0.6 0.55 0.5 1</ambient></material>
        </visual>
        <pose>2.5 -0.025 2.0 0 0 0</pose>
      </link>
    </model>

    <!-- Ceiling -->
    <model name="ceiling">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 0.05 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 0.05 4.0</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient></material>
        </visual>
        <pose>2.5 2.525 2.0 0 0 0</pose>
      </link>
    </model>

    <!-- Wall: -X (left) -->
    <model name="wall_left">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 2.5 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 2.5 4.0</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient></material></visual>
        <pose>0.075 1.25 2.0 0 0 0</pose>
      </link>
    </model>

    <!-- Wall: +X (right) -->
    <model name="wall_right">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 2.5 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 2.5 4.0</size></box></geometry>
          <material><ambient>0.85 0.82 0.78 1</ambient></material></visual>
        <pose>4.925 1.25 2.0 0 0 0</pose>
      </link>
    </model>

    <!-- Wall: -Z (front) -->
    <model name="wall_front">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 2.5 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.0 2.5 0.15</size></box></geometry>
          <material><ambient>0.82 0.80 0.76 1</ambient></material></visual>
        <pose>2.5 1.25 0.075 0 0 0</pose>
      </link>
    </model>

    <!-- Wall: +Z (back) -->
    <model name="wall_back">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>5.0 2.5 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.0 2.5 0.15</size></box></geometry>
          <material><ambient>0.82 0.80 0.76 1</ambient></material></visual>
        <pose>2.5 1.25 3.925 0 0 0</pose>
      </link>
    </model>

    <!-- ── Divider Wall (creates occlusion) ─────────────────────────── -->
    <!-- Half-height wall blocking view of rear furniture -->
    <model name="divider_wall">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>2.0 1.2 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 1.2 0.15</size></box></geometry>
          <material><ambient>0.7 0.65 0.6 1</ambient></material></visual>
        <pose>2.5 0.6 2.0 0 0 0</pose>
      </link>
    </model>

    <!-- ── Visible Furniture (front area, BLUE/TEAL) ─────────────────── -->

    <!-- Sofa -->
    <model name="sofa">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.85 0.7</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.85 0.7</size></box></geometry>
          <material><ambient>0.3 0.3 0.6 1</ambient></material></visual>
        <pose>1.5 0.425 0.8 0 0 0</pose>
      </link>
    </model>

    <!-- Coffee Table -->
    <model name="coffee_table">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.4 0.5</size></box></geometry>
          <material><ambient>0.55 0.4 0.2 1</ambient></material></visual>
        <pose>1.5 0.2 1.35 0 0 0</pose>
      </link>
    </model>

    <!-- ── Occluded Furniture (rear area, GREEN target) ──────────────── -->

    <!-- Occluded Chair (behind divider) -->
    <model name="chair_occluded">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.9 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.9 0.5</size></box></geometry>
          <material><ambient>0.6 0.35 0.15 1</ambient></material></visual>
        <pose>1.3 0.45 2.9 0 0 0</pose>
      </link>
    </model>

    <!-- Occluded Desk (behind divider) -->
    <model name="desk_occluded">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.75 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.75 0.6</size></box></geometry>
          <material><ambient>0.5 0.45 0.35 1</ambient></material></visual>
        <pose>3.2 0.375 3.2 0 0 0</pose>
      </link>
    </model>

    <!-- Occluded Box (behind divider) -->
    <model name="box_occluded">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.4 0.6 0.4 1</ambient></material></visual>
        <pose>3.8 0.15 3.5 0 0 0</pose>
      </link>
    </model>

    <!-- ── Robot spawn point ────────────────────────────────────────── -->
    <!-- TurtleBot3 spawns at front-centre, facing toward divider -->
    <!-- Spawn command in launch file: x=2.5, y=0.5, z=0.1, yaw=1.57 -->

  </world>
</sdf>
